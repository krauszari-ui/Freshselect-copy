# ─────────────────────────────────────────────────────────────────────────────
# FreshSelect Meals — environment variables
#
# Copy to `.env` for local work:  cp .env.example .env
# In production (Vercel): set these under Project → Settings → Environment
# Variables → Production, then REDEPLOY (env vars only apply to new deployments).
#
# Every variable below is read in server/_core/env.ts (or server/db.ts / the
# compliance flags). Values here are placeholders — never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED for login to work ───────────────────────────────────────────────

# MySQL / TiDB connection string. Without it there is no database, so no users
# exist and admin login returns "Invalid email or password".
# TiDB Cloud Serverless example (note the TLS query params):
#   mysql://<user>:<password>@<host>:4000/<database>?ssl={"rejectUnauthorized":true}
# PlanetScale / MySQL 8 also work. The app enables TLS for any non-localhost host.
DATABASE_URL="mysql://user:password@host:4000/freshselect?ssl={\"rejectUnauthorized\":true}"

# Secret used to sign/verify the session JWT cookie. REQUIRED in production —
# without it the server cannot issue a login session. Use a long random value:
#   openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string"

# Node environment. Vercel sets this to "production" automatically for prod
# deployments; set it locally when testing the production build.
NODE_ENV="development"


# ── OPTIONAL — email (Resend). Needed for password-reset emails, client email,
#    inbound reply webhook, and email blasts. Login itself does NOT require these.
RESEND_API_KEY=""
# From address (verify your domain in Resend first):
RESEND_FROM_EMAIL="FreshSelect Meals <onboarding@resend.dev>"
# Secret for verifying the inbound-email webhook signature (Svix):
RESEND_WEBHOOK_SECRET=""
# Domain used to build blast reply-to addresses:
RESEND_INBOUND_DOMAIN="inbound.freshselectmeals.com"


# ── OPTIONAL — file storage (Cloudflare R2). Needed for document uploads. ─────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="freshselect-documents"
# Optional public CDN URL for the bucket (leave empty for private + presigned URLs):
R2_PUBLIC_URL=""

# Manus Forge storage — LOCAL DEV FALLBACK only (used when R2 is not configured):
BUILT_IN_FORGE_API_URL=""
BUILT_IN_FORGE_API_KEY=""


# ── OPTIONAL — scheduled jobs ────────────────────────────────────────────────
# Secret required to invoke /api/cron/send-blasts. Vercel Cron sends it as
# `Authorization: Bearer <secret>` when configured.
CRON_SECRET=""


# ── OPTIONAL — misc ──────────────────────────────────────────────────────────
# JWT audience claim (defaults to "freshselect-meals" if unset):
VITE_APP_ID="freshselect-meals"
# Local server port (defaults to 3000):
PORT="3000"


# ── OPTIONAL — Compliance & Audit module (all default OFF) ───────────────────
# Turn the compliance module on gradually. When unset/false, the module is
# invisible and the app behaves exactly as before. Requires the compliance
# tables to exist (see SETUP.md). See AUDIT_SYSTEM_IMPLEMENTATION_PLAN.md.
COMPLIANCE_MODULE="false"   # master switch: nav, routes, and procedures
COMPLIANCE_GATES="false"    # enforce readiness/invoicing gates (else advisory-only)
COMPLIANCE_MFA="false"      # require MFA for privileged roles
COMPLIANCE_SESSIONS="false" # enforce server-side sessions (revocation, idle/absolute timeout, reauth)
COMPLIANCE_WORKER="false"   # run the durable job-queue worker loop in-process (persistent servers only)
COMPLIANCE_WORKER_INTERVAL_MS="5000"  # worker poll interval when COMPLIANCE_WORKER is on
# REDIS_URL=""              # optional: distributed rate-limit store (ioredis); in-memory fallback if unset
